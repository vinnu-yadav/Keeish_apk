    // 4-second sequence:
    // 1. Success access -> Bulb morphs to Heart shape (love) with pulse & Keeish text reveal (~1.1s)
    // 2. Heart expands smoothly to full screen (~1.4s)
    // 3. Heart fades out gracefully (~1.5s), entering the dashboard exactly at 4 seconds.
    async function playGentlyRevealAndEnter(callback) {
      if (isRevealingKeeish) return;
      isRevealingKeeish = true;

      // Keep the user on the successful-login page for 6 seconds
      // before beginning the animated transition to the dashboard.
      await new Promise(r => setTimeout(r, 2000));

      const startTime = Date.now();

      const logo = $("brandLogo");
      const eyebrow = $("brandEyebrow");
      const heading = $("brandHeading");
      const subtitle = $("brandSubtitle");
      const banner = $("revealBanner");

      // Stage 1: Morph bulb to Heart (Love) shape with rose glow
      logo.className = "brand heart-mode";
      logo.innerHTML = heartSvgMarkup;

      banner.style.display = "block";
      banner.innerHTML = "<span>❤️ Access Granted — Welcome to Keeish…</span>";

      eyebrow.textContent = "Keeish · Private Space";
      heading.innerHTML = "Your people.<br>Your space.";
      subtitle.textContent = "Welcome back to Keeish Chat.";
      document.title = "Keeish Chat";

      // Let user enjoy the heart morph on the card for ~1100ms
      await new Promise(r => setTimeout(r, 1100));

      // Stage 2: Enlarge heart shape as full screen
      const overlay = $("heartTransitionOverlay");
      const expander = $("heartExpander");
      overlay.hidden = false;
      overlay.classList.remove("overlay-fadeout");
      expander.classList.remove("heart-grow-anim");
      // Trigger CSS animation restart
      void expander.offsetWidth;
      expander.classList.add("heart-grow-anim");

      // Allow heart to grow and cover full screen
      await new Promise(r => setTimeout(r, 1400));

      // Stage 3: Hide login screen, prepare dashboard behind full-screen heart
      $("loginScreen").hidden = true;
      banner.style.display = "none";

      if (callback) callback();
      $("chatScreen").classList.add("anim-enter");

      // Stage 4: Gently fade out the full-screen heart overlay
      overlay.classList.add("overlay-fadeout");

      // Ensure total elapsed time from start is precisely 4 seconds (4000ms)
      const elapsed = Date.now() - startTime;
      const remainingTime = Math.max(0, 4000 - elapsed);
      await new Promise(r => setTimeout(r, remainingTime));

      overlay.hidden = true;
      overlay.classList.remove("overlay-fadeout");
      isRevealingKeeish = false;
    }

    function formatTime(value) {
      if (value === null || value === undefined) {
        return "Not available";
      }

      const date = new Date(value);

      if (Number.isNaN(date.getTime())) {
        return "Not available";
      }

      return date.toLocaleString([], {
        year: "numeric",
        month: "short",
        day: "numeric",
        hour: "2-digit",
        minute: "2-digit"
      });
    }

    function updateSendButton() {
      $("sendButton").disabled =
        !currentUser ||
        !chatName ||
        !connected ||
        !messagesLoaded ||
        !$("messageInput").value.trim();
    }

    function closeUnsendOverlay() {
      document.querySelector(".unsend-overlay")?.remove();
    }

    function clearLongPress() {
      if (longPressTimer) {
        clearTimeout(longPressTimer);
        longPressTimer = null;
      }
    }

    function showUnsendOverlay(messageId, element) {
      const message = currentMessages.get(messageId);

      if (!message || message.uid !== currentUser.uid) {
        return;
      }

      closeUnsendOverlay();

      const overlay = document.createElement("div");
      overlay.className = "unsend-overlay";

      const unsend = document.createElement("button");
      unsend.className = "unsend-button";
      unsend.type = "button";
      unsend.textContent = "↩ Unsend";

      const cancel = document.createElement("button");
      cancel.className = "cancel-unsend-button";
      cancel.type = "button";
      cancel.textContent = "Cancel";

      unsend.onclick = async event => {
        event.stopPropagation();
        unsend.disabled = true;
        unsend.textContent = "Removing…";

        try {
          await remove(ref(db, `${BASE}/messages/${messageId}`));
          closeUnsendOverlay();
        } catch (error) {
          console.error(error);
          unsend.disabled = false;
          unsend.textContent = "↩ Unsend";
          $("chatError").textContent =
            "Message could not be unsent.";
        }
      };

      cancel.onclick = event => {
        event.stopPropagation();
        closeUnsendOverlay();
      };

      overlay.append(unsend, cancel);
      element.appendChild(overlay);
    }

    function attachMessageEvents(element, messageId, message) {
      if (!currentUser || message.uid !== currentUser.uid) {
        return;
      }

      element.oncontextmenu = event => {
        event.preventDefault();
        showUnsendOverlay(messageId, element);
      };

      element.onpointerdown = event => {
        if (event.target.closest(".unsend-overlay")) {
          return;
        }

        clearLongPress();
        longPressTriggered = false;

        longPressTimer = setTimeout(() => {
          longPressTriggered = true;
          showUnsendOverlay(messageId, element);
        }, 600);
      };

      element.onpointerup = clearLongPress;
      element.onpointercancel = clearLongPress;
      element.onpointerleave = clearLongPress;
    }

    function showMessageInfo(messageId, message) {
      $("infoSender").textContent =
        message.senderName ||
        (message.uid === currentUser.uid ? "You" : "Unknown member");

      $("infoText").textContent = message.text || "";
      $("infoSent").textContent = formatTime(message.createdAt);
      $("infoSeen").textContent = "Loading…";
      $("infoModal").hidden = false;

      get(ref(db, `${BASE}/messageSeen/${messageId}`))
        .then(snapshot => {
          if (!snapshot.exists()) {
            $("infoSeen").textContent = "Not seen yet";
            return;
          }

          const values = Object.values(snapshot.val() || {})
            .filter(value => typeof value === "number")
            .sort((a, b) => b - a);

          $("infoSeen").textContent = values.length
            ? formatTime(values[0])
            : "Not seen yet";
        })
        .catch(() => {
          $("infoSeen").textContent = "Not available";
        });
    }

    function createMessageElement(id, message) {
      const mine = message.uid === currentUser.uid;
      const element = document.createElement("article");

      element.className = mine ? "message mine" : "message";

      const sender = document.createElement("div");
      sender.className = "sender";
      sender.textContent = mine
        ? "You"
        : message.senderName || "Unknown member";

      const body = document.createElement("div");
      body.className = "body";
      body.textContent = message.text || "";

      const time = document.createElement("div");
      time.className = "time";
      time.textContent = formatTime(message.createdAt);

      element.append(sender, body, time);

      element.onclick = () => {
        if (longPressTriggered) {
          longPressTriggered = false;
          return;
        }

        showMessageInfo(id, message);
      };

      attachMessageEvents(element, id, message);
      return element;
    }

    function renderMessages(snapshot) {
      currentMessages.clear();

      const fragment = document.createDocumentFragment();

      if (!snapshot.exists()) {
        const empty = document.createElement("div");
        empty.className = "empty";
        empty.textContent = "No messages yet. Say hello!";
        fragment.appendChild(empty);
      } else {
        snapshot.forEach(child => {
          const message = child.val();
          currentMessages.set(child.key, message);
          fragment.appendChild(
            createMessageElement(child.key, message)
          );
        });
      }

      $("messages").replaceChildren(fragment);
      $("messages").scrollTop = $("messages").scrollHeight;

      messagesLoaded = true;
      updateSendButton();

      snapshot.forEach(child => {
        const message = child.val();

        if (message.uid !== currentUser.uid) {
          set(
            ref(
              db,
              `${BASE}/messageSeen/${child.key}/${currentUser.uid}`
            ),
            serverTimestamp()
          ).catch(() => {});
        }
      });
    }

    function renderUsers() {
      const ids = new Set([
        ...Object.keys(registeredUsers),
        ...Object.keys(presenceData)
      ]);

      const users = [...ids]
        .map(uid => {
          const saved = registeredUsers[uid] || {};
          const presence = presenceData[uid] || {};
          const tabs = presence.tabs || {};
          const tabList = Object.values(tabs).filter(Boolean);
          const anyOnline = tabList.some(
            tab => tab && tab.online === true
          );

          return {
            uid,
            name:
              saved.chatName ||
              presence.chatName ||
              tabList[0]?.chatName ||
              "",
            online: anyOnline
          };
        })
        .filter(user => user.name.trim())
        .sort((a, b) => a.name.localeCompare(b.name));

      const active = users.filter(user => user.online).length;
      const inactive = users.length - active;
      const summary = `${active} active · ${inactive} inactive · ${users.length} total`;

      $("userSummary").textContent = summary;
      $("usersCount").textContent = summary;

      const list = $("usersList");
      list.replaceChildren();

      if (!users.length) {
        const empty = document.createElement("div");
        empty.className = "muted";
        empty.textContent = "No named users found.";
        list.appendChild(empty);
        return;
      }

      users.forEach(user => {
        const row = document.createElement("div");
        row.className = "user-row";

        const name = document.createElement("strong");
        name.className = "user-name";
        name.textContent = user.uid === currentUser.uid
