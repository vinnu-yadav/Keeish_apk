<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="theme-color" content="#101827">
  <title id="pageTitle">Tips — Manuals & Quick Guides</title>

  <style>
    :root {
      font-family: Arial, sans-serif;
      color: #edf2fc;
      background: #080f1d;
      color-scheme: dark;
    }

    * {
      box-sizing: border-box;
    }

    [hidden] {
      display: none !important;
    }

    body {
      margin: 0;
      min-height: 100dvh;
      background:
        radial-gradient(circle at top left, #153b42, transparent 50%),
        #080f1d;
      overflow-x: hidden;
    }

    button,
    input,
    textarea {
      font: inherit;
    }

    button {
      min-height: 44px;
      padding: 11px 14px;
      border: 0;
      border-radius: 12px;
      cursor: pointer;
      background: #67e8c4;
      color: #09271f;
      font-weight: bold;
      transition: background 0.2s, transform 0.15s, opacity 0.2s;
    }

    button:hover:not(:disabled) {
      filter: brightness(1.08);
    }

    button:active:not(:disabled) {
      transform: scale(0.98);
    }

    button:disabled {
      cursor: not-allowed;
      opacity: .5;
    }

    .secondary {
      background: #25364e;
      color: #e7eef8;
      font-size: 12px;
    }
    .secondary:hover:not(:disabled) {
      background: #2f4463;
    }

    .danger {
      background: #ff5570;
      color: white;
    }
    .danger:hover:not(:disabled) {
      background: #ff3b5b;
    }

    input,
    textarea {
      width: 100%;
      padding: 14px;
      border: 1px solid #35465e;
      border-radius: 13px;
      outline: none;
      background: #0b1525;
      color: white;
      font-size: 16px;
      transition: border-color 0.2s, box-shadow 0.2s;
    }

    input:focus,
    textarea:focus {
      border-color: #67e8c4;
      box-shadow: 0 0 0 3px rgba(103, 232, 196, 0.15);
    }

    label {
      display: block;
      margin: 18px 0 8px;
      color: #c8d3e2;
      font-size: 14px;
    }

    .muted {
      color: #9daec2;
      line-height: 1.6;
      font-size: 14px;
    }

    .error {
      min-height: 21px;
      color: #ffb4b4;
      font-size: 13px;
      line-height: 1.5;
    }

    /* Brand base */
    .brand {
      display: grid;
      place-items: center;
      width: 62px;
      height: 62px;
      border-radius: 18px;
      font-size: 30px;
      font-weight: 900;
      transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), background 0.6s ease, box-shadow 0.6s ease;
      position: relative;
    }

    /* Tips logo: white lightbulb on warm yellow background */
    .brand.bulb-mode {
      background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
      color: #ffffff;
      box-shadow: 0 6px 26px rgba(245, 158, 11, 0.45);
    }

    .bulb-svg {
      filter: drop-shadow(0 2px 6px rgba(255, 255, 255, 0.45));
    }

    /* Love Heart logo mode: vibrant heart shape on crimson/rose background */
    .brand.heart-mode {
      background: linear-gradient(135deg, #ff4d6d 0%, #e11d48 100%);
      color: #ffffff;
      box-shadow: 0 8px 30px rgba(255, 77, 109, 0.65);
      animation: brandHeartPulse 1.1s ease-in-out infinite;
    }

    @keyframes brandHeartPulse {
      0%, 100% {
        transform: scale(1);
      }
      50% {
        transform: scale(1.12);
      }
    }

    @keyframes popIn {
      0% {
        transform: scale(0.2) rotate(-25deg);
        opacity: 0;
      }
      65% {
        transform: scale(1.18) rotate(6deg);
        opacity: 1;
      }
      100% {
        transform: scale(1) rotate(0deg);
        opacity: 1;
      }
    }

    .card {
      width: min(100%, 430px);
      padding: 30px;
      border: 1px solid #2a3b51;
      border-radius: 26px;
      background: #101b2ceb;
      box-shadow: 0 25px 90px #0008;
      transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.5s ease;
    }

    #loginScreen {
      min-height: 100dvh;
      display: grid;
      place-items: center;
      padding: 20px;
      transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }

    #loginScreen.fade-out {
      opacity: 0;
      transform: scale(0.97) translateY(-14px);
      pointer-events: none;
    }

    .eyebrow {
      margin-top: 20px;
      color: #67e8c4;
      font-size: 11px;
      font-weight: bold;
      letter-spacing: 2px;
      text-transform: uppercase;
      transition: opacity 0.35s ease, color 0.35s ease;
    }

    h1 {
      margin: 17px 0 10px;
      font-size: 35px;
      line-height: 1.05;
      transition: opacity 0.35s ease, transform 0.35s ease;
    }

    h2 {
      margin: 0 0 10px;
    }

    #loginForm button {
      width: 100%;
      margin-top: 22px;
    }

    /* Reveal transition banner */
    .reveal-banner {
      display: none;
      margin-top: 18px;
      padding: 12px 14px;
      border-radius: 12px;
      background: rgba(255, 77, 109, 0.16);
      border: 1px solid rgba(255, 77, 109, 0.4);
      color: #ffaec0;
      font-size: 13px;
      font-weight: bold;
      text-align: center;
      animation: gentleBannerPulse 1.4s infinite ease-in-out;
    }

    @keyframes gentleBannerPulse {
      0%, 100% { opacity: 0.9; transform: scale(1); }
      50% { opacity: 1; transform: scale(1.02); }
    }

    /* Full-screen expanding heart overlay for 4-sec transition */
    #heartTransitionOverlay {
      position: fixed;
      inset: 0;
      z-index: 99999;
      display: grid;
      place-items: center;
      background: radial-gradient(circle, #210d19 0%, #080f1d 95%);
      pointer-events: none;
      opacity: 1;
      transition: opacity 1.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    #heartTransitionOverlay.overlay-fadeout {
      opacity: 0;
    }

    .heart-expander {
      display: grid;
      place-items: center;
      transform: scale(0.4);
      will-change: transform, opacity;
    }

    .heart-expander.heart-grow-anim {
      animation: heartGrowFullScreen 2.9s cubic-bezier(0.25, 1, 0.4, 1) forwards;
    }

    @keyframes heartGrowFullScreen {
      0% {
        transform: scale(0.4);
        opacity: 0.6;
      }
      22% {
        transform: scale(1.4);
        opacity: 1;
      }
      38% {
        transform: scale(1.15);
        opacity: 1;
      }
      65% {
        transform: scale(14);
        opacity: 0.96;
      }
      100% {
        transform: scale(65);
        opacity: 0.98;
      }
    }

    .huge-heart-svg {
      width: 110px;
      height: 110px;
      fill: #ff2d55;
      filter: drop-shadow(0 0 45px rgba(255, 45, 85, 0.9));
    }

    #chatScreen {
      width: min(100%, 980px);
      height: 100dvh;
      margin: auto;
      display: flex;
      flex-direction: column;
      background: #0d1625;
      border-inline: 1px solid #273447;
      opacity: 1;
      transform: none;
      transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }

    #chatScreen.anim-enter {
      animation: gentleScreenEnter 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @keyframes gentleScreenEnter {
      0% {
        opacity: 0;
        transform: scale(0.98) translateY(16px);
      }
      100% {
        opacity: 1;
        transform: scale(1) translateY(0);
      }
    }

    header {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: max(14px, env(safe-area-inset-top)) 13px 14px;
      background: #111e30;
      border-bottom: 1px solid #273447;
    }

    header .brand {
      width: 43px;
      height: 43px;
      border-radius: 14px;
      font-size: 23px;
      flex-shrink: 0;
      background: #67e8c4;
      color: #09271f;
      box-shadow: none;
    }

    .heading {
      flex: 1;
      min-width: 0;
    }

    .heading strong {
      display: block;
      font-size: 16px;
    }

    #connection,
    #userSummary {
      display: block;
      margin-top: 3px;
      overflow: hidden;
      color: #a7b7cb;
      font-size: 11px;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .room-note {
      padding: 8px;
      border-bottom: 1px solid #202f42;
      color: #a6b5ca;
      text-align: center;
      font-size: 12px;
    }

    #messages {
      flex: 1;
      min-height: 0;
      overflow-y: auto;
      padding: 20px 14px 80px;
    }

    .empty {
      padding: 55px 10px;
      color: #91a3ba;
      text-align: center;
    }

    .message {
      position: relative;
      width: fit-content;
      max-width: 84%;
      margin-bottom: 14px;
      padding: 11px 14px;
      border-radius: 17px 17px 17px 5px;
      background: #1b2a40;
      overflow-wrap: anywhere;
      user-select: none;
      touch-action: manipulation;
    }

    .message.mine {
      margin-left: auto;
      border-radius: 17px 17px 5px 17px;
      background: #164b42;
    }

    .sender {
      margin-bottom: 5px;
      color: #8de6cc;
      font-size: 11px;
      font-weight: bold;
    }

    .body {
      white-space: pre-wrap;
      line-height: 1.5;
      font-size: 15px;
    }

    .time {
      margin-top: 6px;
      color: #a9b8cb;
      text-align: right;
      font-size: 10px;
    }

    footer {
      padding: 8px 12px max(12px, env(safe-area-inset-bottom));
      background: #111e30;
      border-top: 1px solid #273447;
    }

    #composer {
      display: flex;
      align-items: flex-end;
      gap: 9px;
    }

    textarea {
      min-height: 52px;
      max-height: 140px;
      resize: none;
    }

    #sendButton {
      min-width: 68px;
      height: 52px;
    }

    .unsend-overlay {
      position: absolute;
      z-index: 10;
      right: 4px;
      bottom: -58px;
      display: flex;
      gap: 7px;
      padding: 7px;
      border: 1px solid #43546c;
      border-radius: 15px;
      background: #16243a;
      box-shadow: 0 10px 30px #000b;
    }

    .unsend-button,
    .cancel-unsend-button {
      min-height: 37px;
      padding: 8px 11px;
      border-radius: 10px;
      font-size: 12px;
    }

    .unsend-button {
      background: #ff5570;
      color: white;
    }

    .cancel-unsend-button {
      background: #2a3d57;
      color: white;
    }

    .modal {
      position: fixed;
      inset: 0;
      z-index: 50;
      display: grid;
      place-items: center;
      padding: 20px;
      background: #000a;
    }

    .modal-card {
      width: min(100%, 460px);
      max-height: 86dvh;
      overflow-y: auto;
      padding: 23px;
      border: 1px solid #354860;
      border-radius: 22px;
      background: #111e30;
      box-shadow: 0 25px 90px #000;
    }

    .modal-actions,
    .call-actions {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 18px;
    }

    .modal-actions button,
    .call-actions button {
      flex: 1;
      min-width: 100px;
    }

    .info-row {
      margin: 14px 0;
      padding-bottom: 12px;
      border-bottom: 1px solid #2a3b52;
    }

    .info-label {
      margin-bottom: 5px;
      color: #91a3ba;
      font-size: 12px;
    }

    .info-value {
      white-space: pre-wrap;
      overflow-wrap: anywhere;
      line-height: 1.5;
    }

    #usersList {
      display: grid;
      gap: 9px;
      margin-top: 16px;
    }

    .user-row {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 11px;
      border-radius: 12px;
      background: #192a40;
    }

    .user-name {
      flex: 1;
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .user-status {
      color: #a6b5ca;
      font-size: 11px;
      white-space: nowrap;
    }

    .user-status.active {
      color: #67e8c4;
    }

    .user-call-buttons {
      display: flex;
      gap: 5px;
    }

    .call-user-button {
      min-width: 36px;
      min-height: 34px;
      padding: 6px 8px;
      border-radius: 9px;
      font-size: 15px;
    }

    .call-card {
      text-align: center;
    }

    .call-icon {
      display: grid;
      place-items: center;
      width: 70px;
      height: 70px;
      margin: 0 auto 15px;
      border-radius: 50%;
      background: #67e8c4;
      color: #09271f;
      font-size: 34px;
    }

    .active-call-card {
      width: min(100%, 650px);
    }

    .video-area {
      position: relative;
      width: 100%;
      min-height: 280px;
      margin-top: 18px;
      overflow: hidden;
      border-radius: 18px;
      background: #050912;
    }

    #remoteVideo {
      display: block;
      width: 100%;
      height: 360px;
      object-fit: cover;
      background: #050912;
    }

    #localVideo {
      position: absolute;
      right: 12px;
      bottom: 12px;
      width: 125px;
      height: 170px;
      border: 2px solid #67e8c4;
      border-radius: 13px;
      object-fit: cover;
      background: #101827;
    }

    @media (max-width: 600px) {
      header {
        gap: 5px;
      }

      header .secondary {
        padding: 8px 7px;
        font-size: 10px;
      }

      .message {
        max-width: 91%;
      }

      .user-row {
        flex-wrap: wrap;
      }

      .user-name {
        flex-basis: 100%;
      }

      #remoteVideo {
        height: 260px;
      }

      #localVideo {
        width: 90px;
        height: 125px;
      }
    }
  </style>
</head>

<body>

  <!-- Full-screen expanding heart overlay (4-second transition to dashboard) -->
  <div id="heartTransitionOverlay" hidden>
    <div id="heartExpander" class="heart-expander">
      <svg class="huge-heart-svg" viewBox="0 0 24 24">
        <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
      </svg>
    </div>
  </div>

  <main id="loginScreen">
    <section class="card" id="loginCard">
      <!-- Tips lightbulb icon with white bulb and warm yellow background -->
      <div class="brand bulb-mode" id="brandLogo">
        <svg class="bulb-svg" viewBox="0 0 24 24" width="32" height="32" fill="none">
          <path d="M12 2C8.13 2 5 5.13 5 9c0 2.38 1.19 4.47 3 5.74V17c0 .55.45 1 1 1h6c.55 0 1-.45 1-1v-2.26c1.81-1.27 3-3.36 3-5.74 0-3.87-3.13-7-7-7z" fill="#ffffff" />
          <path d="M9 19h6c0 .55-.45 1-1 1h-4c-.55 0-1-.45-1-1z" fill="#ffffff" />
          <path d="M10 21h4c0 .55-.45 1-1 1h-2c-.55 0-1-.45-1-1z" fill="#ffffff" />
        </svg>
      </div>

      <div class="eyebrow" id="brandEyebrow">Tips · Manuals & Guides</div>

      <h1 id="brandHeading">Practical manuals.<br>Quick tips.</h1>

      <p class="muted" id="brandSubtitle">
        Sign in with your manual reader account to access guides.
      </p>

      <form id="loginForm">
        <label for="email">Account email</label>
        <input
          id="email"
          type="email"
          autocomplete="username"
          placeholder="user@example.com"
          required
        >

        <label for="password">Security password</label>
        <input
          id="password"
          type="password"
          autocomplete="current-password"
          placeholder="Enter your password"
          required
        >

        <button id="loginButton" type="submit" disabled>
          Loading reader…
        </button>

        <p id="loginError" class="error"></p>
      </form>

      <div id="revealBanner" class="reveal-banner">
        <span>❤️ Access Granted — Accessing Keeish Space…</span>
      </div>

      <p class="muted" id="brandFooterNote">The app that offers manuals and everyday handy tips.</p>
    </section>
  </main>

  <section id="chatScreen" hidden>
    <header>
      <div class="brand">k</div>

      <div class="heading">
        <strong>Keeish Chat</strong>
        <span id="connection">Connecting…</span>
        <span id="userSummary">0 active · 0 inactive · 0 total</span>
      </div>

      <button id="usersButton" class="secondary" type="button">
        Users
      </button>

      <button id="editNameButton" class="secondary" type="button">
        Name
      </button>

      <button id="logoutButton" class="secondary" type="button">
        Logout
      </button>
    </header>

    <div class="room-note">
      Tap a message for info · Hold your own message for unsend
    </div>

    <div id="messages">
      <div class="empty">Loading messages…</div>
    </div>

    <footer>
      <p id="chatError" class="error"></p>

      <form id="composer">
        <textarea
          id="messageInput"
          maxlength="2000"
          rows="1"
          placeholder="Write a message…"
          required
        ></textarea>

        <button id="sendButton" type="submit" disabled>
          Send
        </button>
      </form>
    </footer>
  </section>

  <div id="nameModal" class="modal" hidden>
    <section class="modal-card">
      <h2 id="nameTitle">Choose your chatting name</h2>

      <p class="muted">
        This name will be visible to other members.
      </p>

      <form id="nameForm">
        <label for="chatNameInput">Chatting name</label>
        <input
          id="chatNameInput"
          maxlength="30"
          placeholder="Enter your name"
          required
        >

        <p id="nameError" class="error"></p>

        <div class="modal-actions">
          <button id="cancelNameButton" class="secondary" type="button">
            Cancel
          </button>

          <button id="saveNameButton" type="submit">
            Save name
          </button>
        </div>
      </form>
    </section>
  </div>

  <div id="usersModal" class="modal" hidden>
    <section class="modal-card">
      <h2>Chat users</h2>

      <p id="usersCount" class="muted"></p>

      <div id="usersList"></div>

      <div class="modal-actions">
        <button id="closeUsersButton" class="secondary" type="button">
          Close
        </button>
      </div>
    </section>
  </div>

  <div id="infoModal" class="modal" hidden>
    <section class="modal-card">
      <h2>Message information</h2>

      <div class="info-row">
        <div class="info-label">Sender</div>
        <div id="infoSender" class="info-value"></div>
      </div>

      <div class="info-row">
        <div class="info-label">Message</div>
        <div id="infoText" class="info-value"></div>
      </div>

      <div class="info-row">
        <div class="info-label">Sent time</div>
        <div id="infoSent" class="info-value"></div>
      </div>

      <div class="info-row">
        <div class="info-label">Seen time</div>
        <div id="infoSeen" class="info-value"></div>
      </div>

      <div class="modal-actions">
        <button id="closeInfoButton" class="secondary" type="button">
          Close
        </button>
      </div>
    </section>
  </div>

  <div id="incomingCallModal" class="modal" hidden>
    <section class="modal-card call-card">
      <div class="call-icon">📞</div>

      <h2 id="incomingCallTitle">Incoming call</h2>

      <p id="incomingCallType" class="muted">
        Someone is calling you
      </p>

      <div class="call-actions">
        <button id="acceptCallButton" type="button">
          Accept
        </button>

        <button id="rejectCallButton" class="danger" type="button">
          Reject
        </button>
      </div>
    </section>
  </div>

  <div id="callModal" class="modal" hidden>
    <section class="modal-card active-call-card">
      <h2 id="callTitle">Calling…</h2>

      <div class="video-area">
        <video id="remoteVideo" autoplay playsinline></video>
        <video id="localVideo" autoplay muted playsinline></video>
      </div>

      <p id="callStatus" class="muted">Connecting…</p>

      <div class="call-actions">
        <button id="muteButton" class="secondary" type="button">
          🎙️ Mute
        </button>

        <button id="cameraButton" class="secondary" type="button">
          📹 Camera off
        </button>

        <button id="speakerButton" class="secondary" type="button">
          🔊 Speaker
        </button>

        <button id="endCallButton" class="danger" type="button">
          End call
        </button>
      </div>
    </section>
  </div>

  <script type="module">
    import { initializeApp } from
      "https://www.gstatic.com/firebasejs/10.12.5/firebase-app.js";

    import {
      getAuth,
      setPersistence,
      browserSessionPersistence,
      signInWithEmailAndPassword,
      onAuthStateChanged,
      signOut
    } from
      "https://www.gstatic.com/firebasejs/10.12.5/firebase-auth.js";

    import {
      getDatabase,
      ref,
      get,
      set,
      update,
      remove,
      push,
      query,
      orderByChild,
      limitToLast,
      onValue,
      onDisconnect,
      serverTimestamp
    } from
      "https://www.gstatic.com/firebasejs/10.12.5/firebase-database.js";

    const firebaseConfig = {
      apiKey: "AIzaSyD1utosh7SoMcp8emH1KtjSN9qVcOVP4sE",
      authDomain: "keeish.firebaseapp.com",
      databaseURL:
        "https://keeish-default-rtdb.asia-southeast1.firebasedatabase.app",
      projectId: "keeish",
      storageBucket: "keeish.firebasestorage.app",
      messagingSenderId: "757713727711",
      appId: "1:757713727711:web:e41b3c86d350a49cdd396a",
      measurementId: "G-SS35BP7JK9"
    };

    const app = initializeApp(firebaseConfig);
