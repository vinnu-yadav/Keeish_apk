    async function setupPresence() {
      presenceRef = ref(db, `${BASE}/presence/${currentUser.uid}`);

      const tabId =
        `${Date.now()}_${Math.random().toString(36).slice(2, 8)}`;
      presenceTabRef = ref(
        db,
        `${BASE}/presence/${currentUser.uid}/tabs/${tabId}`
      );

      await onDisconnect(presenceTabRef).remove();

      await set(presenceTabRef, {
        chatName,
        online: true,
        lastActive: serverTimestamp()
      });
    }

    function startIncomingRingtone() {
      stopIncomingRingtone();

      try {
        ringtoneContext = new (
          window.AudioContext ||
          window.webkitAudioContext
        )();

        const beep = () => {
          if (!ringtoneContext) {
            return;
          }

          const oscillator =
            ringtoneContext.createOscillator();

          const gain =
            ringtoneContext.createGain();

          oscillator.type = "sine";
          oscillator.frequency.value = 720;

          gain.gain.setValueAtTime(
            0.0001,
            ringtoneContext.currentTime
          );

          gain.gain.exponentialRampToValueAtTime(
            0.18,
            ringtoneContext.currentTime + 0.04
          );

          gain.gain.exponentialRampToValueAtTime(
            0.0001,
            ringtoneContext.currentTime + 0.65
          );

          oscillator.connect(gain);
          gain.connect(ringtoneContext.destination);

          oscillator.start();
          oscillator.stop(
            ringtoneContext.currentTime + 0.7
          );
        };

        ringtoneContext.resume().then(() => {
          beep();
          ringtoneTimer = setInterval(beep, 1400);
        });
      } catch (error) {
        console.error("Ringtone error:", error);
      }
    }

    function stopIncomingRingtone() {
      if (ringtoneTimer) {
        clearInterval(ringtoneTimer);
        ringtoneTimer = null;
      }

      if (ringtoneContext) {
        ringtoneContext.close().catch(() => {});
        ringtoneContext = null;
      }
    }

    function stopCallListeners() {
      callListeners.forEach(stop => {
        try {
          stop();
        } catch {
          // Already stopped.
        }
      });

      callListeners = [];
    }

    function stopLocalMedia() {
      if (localStream) {
        localStream.getTracks().forEach(track => track.stop());
        localStream = null;
      }

      $("localVideo").srcObject = null;
      $("remoteVideo").srcObject = null;
    }

    async function cleanupCall(removeSignal = true) {
      stopIncomingRingtone();
      stopCallListeners();

      if (peerConnection) {
        peerConnection.close();
        peerConnection = null;
      }

      stopLocalMedia();

      const endedCallId = currentCallId;
      currentCallId = null;
      currentCallType = null;
      pendingIncomingCall = null;
      speakerOn = true;
      $("speakerButton").textContent = "🔊 Speaker";

      $("callModal").hidden = true;
      $("incomingCallModal").hidden = true;

      if (removeSignal && endedCallId) {
        await update(
          ref(db, `${BASE}/calls/${endedCallId}`),
          {
            status: "ended",
            endedAt: serverTimestamp()
          }
        ).catch(() => {});

        await remove(
          ref(db, `${BASE}/calls/${endedCallId}`)
        ).catch(() => {});
      }
    }

    async function getMedia(type) {
      if (
        !navigator.mediaDevices ||
        !navigator.mediaDevices.getUserMedia
      ) {
        throw new Error("Calling requires HTTPS or localhost.");
      }

      return navigator.mediaDevices.getUserMedia(
        type === "video"
          ? {
              audio: true,
              video: {
                facingMode: "user",
                width: { ideal: 1280 },
                height: { ideal: 720 }
              }
            }
          : {
              audio: true,
              video: false
            }
      );
    }

    function createPeerConnection(callId, partnerUid) {
      peerConnection = new RTCPeerConnection(rtcConfiguration);

      peerConnection.onicecandidate = event => {
        if (!event.candidate) {
          return;
        }

        const candidateRef = push(
          ref(
            db,
            `${BASE}/calls/${callId}/candidates/${currentUser.uid}`
          )
        );

        set(candidateRef, event.candidate.toJSON())
          .catch(error => {
            console.error("ICE candidate error:", error);
          });
      };

      peerConnection.ontrack = event => {
        if (event.streams[0]) {
          $("remoteVideo").srcObject = event.streams[0];
          routeRemoteAudio();
        }
      };

      peerConnection.onconnectionstatechange = () => {
        if (!peerConnection) {
          return;
        }

        if (peerConnection.connectionState === "connected") {
          $("callStatus").textContent = "Connected";
        }

        if (
          peerConnection.connectionState === "failed" ||
          peerConnection.connectionState === "disconnected"
        ) {
          $("callStatus").textContent = "Connection lost";
        }
      };

      const candidateStop = onValue(
        ref(
          db,
          `${BASE}/calls/${callId}/candidates/${partnerUid}`
        ),
        snapshot => {
          snapshot.forEach(child => {
            const candidate = child.val();

            if (!candidate || !peerConnection) {
              return;
            }

            peerConnection.addIceCandidate(
              new RTCIceCandidate(candidate)
            ).catch(error => {
              console.error("Candidate error:", error);
            });
          });
        }
      );

      callListeners.push(candidateStop);

      let callNodeSeen = false;

      const statusStop = onValue(
        ref(db, `${BASE}/calls/${callId}`),
        snapshot => {
          if (!currentCallId || currentCallId !== callId) {
            return;
          }

          if (!snapshot.exists()) {
            if (callNodeSeen) {
              $("chatError").textContent = "Call ended by peer.";
              cleanupCall(false);
            }
            return;
          }

          callNodeSeen = true;
          const status = snapshot.val()?.status;

          if (status === "ended" || status === "rejected") {
            $("chatError").textContent =
              status === "rejected"
                ? "Call rejected."
                : "Call ended by peer.";
            cleanupCall(true);
          }
        }
      );

      callListeners.push(statusStop);
    }

    async function startCall(partnerUid, partnerName, type) {
      if (!currentUser || currentCallId) {
        return;
      }

      try {
        currentCallId =
          `${currentUser.uid}_${partnerUid}_${Date.now()}`;

        currentCallType = type;
        speakerOn = true;
        $("speakerButton").textContent = "🔊 Speaker";

        $("callTitle").textContent =
          `${type === "video" ? "Video" : "Audio"} call with ${partnerName}`;

        $("callStatus").textContent = "Calling…";
        $("callModal").hidden = false;

        localStream = await getMedia(type);
        $("localVideo").srcObject = localStream;
        $("localVideo").hidden = type !== "video";

        createPeerConnection(currentCallId, partnerUid);

        localStream.getTracks().forEach(track => {
          peerConnection.addTrack(track, localStream);
        });

        const offer = await peerConnection.createOffer();
        await peerConnection.setLocalDescription(offer);

        await set(
          ref(db, `${BASE}/calls/${currentCallId}`),
          {
            callerUid: currentUser.uid,
            callerName: chatName,
            receiverUid: partnerUid,
            callType: type,
            status: "ringing",
            offer: {
              type: offer.type,
              sdp: offer.sdp
            },
            createdAt: serverTimestamp()
          }
        );

        const answerStop = onValue(
          ref(db, `${BASE}/calls/${currentCallId}/answer`),
          async snapshot => {
            const answer = snapshot.val();

            if (
              answer &&
              peerConnection &&
              !peerConnection.currentRemoteDescription
            ) {
              await peerConnection.setRemoteDescription(
                new RTCSessionDescription(answer)
              );

              $("callStatus").textContent = "Connected";
            }
          }
        );

        callListeners.push(answerStop);
      } catch (error) {
        console.error("Start call error:", error);
        $("callStatus").textContent = "Could not start call.";
        await cleanupCall(false);
      }
    }

    function watchIncomingCalls() {
      const callsStop = onValue(
        ref(db, `${BASE}/calls`),
        snapshot => {
          if (!currentUser || currentCallId) {
            return;
          }

          let incoming = null;

          snapshot.forEach(child => {
            const call = child.val();

            if (
              call &&
              call.receiverUid === currentUser.uid &&
              call.status === "ringing"
            ) {
              incoming = {
                id: child.key,
                ...call
              };
            }
          });

          if (
            pendingIncomingCall &&
            !currentCallId
          ) {
            const pendingSnap = snapshot.child(
              pendingIncomingCall.id
            );
            const stillRinging =
              pendingSnap.exists() &&
              pendingSnap.val()?.status === "ringing";

            if (!stillRinging) {
              pendingIncomingCall = null;
              $("incomingCallModal").hidden = true;
              stopIncomingRingtone();
            }
          }

          if (!incoming) {
            return;
          }

          pendingIncomingCall = incoming;

          $("incomingCallTitle").textContent =
            `${incoming.callerName || "Someone"} is calling`;

          $("incomingCallType").textContent =
            incoming.callType === "video"
              ? "Incoming video call"
              : "Incoming audio call";

          $("incomingCallModal").hidden = false;
          startIncomingRingtone();
        },
        error => {
          console.error("Incoming-call listener error:", error);
          $("chatError").textContent =
            "Cannot receive calls. Check your Firebase rules.";
        }
      );

      listeners.push(callsStop);
    }

    async function acceptIncomingCall() {
      stopIncomingRingtone();

      const incoming = pendingIncomingCall;

      if (!incoming || !currentUser) {
        return;
      }

      try {
        currentCallId = incoming.id;
        currentCallType = incoming.callType;
        speakerOn = true;
        $("speakerButton").textContent = "🔊 Speaker";

        $("incomingCallModal").hidden = true;
        $("callModal").hidden = false;

        $("callTitle").textContent =
          `${incoming.callType === "video" ? "Video" : "Audio"} call with ${incoming.callerName}`;

        $("callStatus").textContent = "Connecting…";

        localStream = await getMedia(incoming.callType);
        $("localVideo").srcObject = localStream;
        $("localVideo").hidden =
          incoming.callType !== "video";

        createPeerConnection(
          incoming.id,
          incoming.callerUid
        );

        localStream.getTracks().forEach(track => {
          peerConnection.addTrack(track, localStream);
        });

        await peerConnection.setRemoteDescription(
          new RTCSessionDescription(incoming.offer)
        );

        const answer = await peerConnection.createAnswer();
        await peerConnection.setLocalDescription(answer);

        await update(
          ref(db, `${BASE}/calls/${incoming.id}`),
          {
            status: "accepted",
            answer: {
              type: answer.type,
              sdp: answer.sdp
            }
          }
        );
      } catch (error) {
        console.error("Accept call error:", error);
        await cleanupCall(false);
      }
    }

    async function rejectIncomingCall() {
      stopIncomingRingtone();

      if (pendingIncomingCall) {
        await update(
          ref(db, `${BASE}/calls/${pendingIncomingCall.id}`),
          {
            status: "rejected"
          }
        ).catch(error => {
          console.error("Reject call error:", error);
        });
      }

      pendingIncomingCall = null;
      $("incomingCallModal").hidden = true;
    }

    function toggleMute() {
      const track = localStream?.getAudioTracks()[0];

      if (!track) {
        return;
      }

      track.enabled = !track.enabled;

      $("muteButton").textContent = track.enabled
        ? "🎙️ Mute"
        : "🔇 Unmute";
    }

    function toggleCamera() {
      const track = localStream?.getVideoTracks()[0];

      if (!track) {
        return;
      }

      track.enabled = !track.enabled;

      $("cameraButton").textContent = track.enabled
        ? "📹 Camera off"
        : "📷 Camera on";
    }

    function toggleSpeaker() {
      speakerOn = !speakerOn;

      $("speakerButton").textContent = speakerOn
        ? "🔊 Speaker"
        : "🔈 Earpiece";

      routeRemoteAudio();
    }

    async function routeRemoteAudio() {
      const remote = $("remoteVideo");

      if (typeof remote.setSinkId !== "function") {
        return;
      }

      try {
        const devices =
          await navigator.mediaDevices.enumerateDevices();
        const outputs = devices.filter(
          device => device.kind === "audiooutput"
        );

        let targetId = "";

        if (!speakerOn) {
          const earpiece =
            outputs.find(device =>
              /earpiece|receiver/i.test(device.label || "")
            ) ||
            outputs.find(
              device =>
                !/speaker|default/i.test(device.label || "")
            );
          targetId = earpiece ? earpiece.deviceId : "";
        }

        await remote.setSinkId(targetId);
      } catch (error) {
        console.error("Speaker routing error:", error);
      }
    }

    async function loadChatName() {
      const snapshot = await get(
        ref(db, `${BASE}/users/${currentUser.uid}/chatName`)
      );

      if (
        snapshot.exists() &&
        String(snapshot.val()).trim()
      ) {
        chatName = String(snapshot.val()).trim();
        await playGentlyRevealAndEnter(() => {
          startChat();
        });
        return;
      }

      await playGentlyRevealAndEnter(() => {
        $("nameTitle").textContent = "Choose your chatting name";
        $("chatNameInput").value = "";
        $("cancelNameButton").hidden = true;
        $("nameModal").hidden = false;
      });
    }

    function startChat() {
      document.title = "Keeish Chat";
      $("loginScreen").hidden = true;
      $("chatScreen").hidden = false;

      listeners.push(
        onValue(ref(db, ".info/connected"), snapshot => {
          connected = snapshot.val() === true;

          $("connection").textContent = connected
            ? `Connected as ${chatName}`
            : "Offline · Reconnecting…";

          updateSendButton();
        })
      );

      const messagesQuery = query(
        ref(db, `${BASE}/messages`),
        orderByChild("createdAt"),
        limitToLast(100)
      );

      listeners.push(
        onValue(
          messagesQuery,
          renderMessages,
          error => {
            console.error(error);
            $("chatError").textContent =
              "Cannot load messages.";
          }
        )
      );

      listeners.push(
        onValue(ref(db, `${BASE}/users`), snapshot => {
          registeredUsers = snapshot.val() || {};
          renderUsers();
        })
      );

      listeners.push(
        onValue(ref(db, `${BASE}/presence`), snapshot => {
          presenceData = snapshot.val() || {};
          renderUsers();
        })
      );

      setupPresence().catch(error => {
        console.error(error);
        $("chatError").textContent =
          "Presence could not be started.";
      });

      watchIncomingCalls();
    }

    function cleanup() {
      clearLongPress();
      closeUnsendOverlay();
      stopIncomingRingtone();

      if (peerConnection) {
        peerConnection.close();
        peerConnection = null;
      }

      stopLocalMedia();
      stopCallListeners();

      listeners.forEach(stop => {
        try {
          stop();
        } catch {
          // Already stopped.
        }
      });

      listeners = [];

      if (presenceTabRef) {
        onDisconnect(presenceTabRef).cancel().catch(() => {});
        remove(presenceTabRef).catch(() => {});
        presenceTabRef = null;
      }

      presenceRef = null;
      currentMessages.clear();
      registeredUsers = {};
      presenceData = {};
      chatName = "";
      connected = false;
      messagesLoaded = false;
      currentCallId = null;
      pendingIncomingCall = null;
      isRevealingKeeish = false;

      $("messages").replaceChildren();
      $("messageInput").value = "";
      $("messageInput").style.height = "52px";
      $("userSummary").textContent =
        "0 active · 0 inactive · 0 total";

      updateSendButton();
      applyTipsCamouflage();
    }

    $("loginForm").addEventListener("submit", async event => {
      event.preventDefault();

      $("loginButton").disabled = true;
      $("loginButton").textContent = "Verifying…";
      $("loginError").textContent = "";

      try {
        await signInWithEmailAndPassword(
          auth,
          $("email").value.trim(),
          $("password").value
        );
      } catch (error) {
        console.error("Firebase login error:", error);

        const code = error?.code || "unknown-error";
        const message = {
          "auth/invalid-credential":
            "Invalid email or password.",
          "auth/wrong-password":
            "Incorrect password.",
          "auth/user-not-found":
            "No account found with this email.",
          "auth/invalid-email":
            "Enter a valid email address.",
          "auth/user-disabled":
            "This account has been disabled.",
          "auth/too-many-requests":
            "Too many attempts. Try again later.",
          "auth/network-request-failed":
            "Network error. Check your connection.",
          "auth/operation-not-allowed":
            "Email/Password login is not enabled.",
          "auth/unauthorized-domain":
            "This website domain is not authorized."
        }[code] || `Login failed: ${code}`;

        $("loginError").textContent = message;
      } finally {
        $("loginButton").disabled = false;
        $("loginButton").textContent = "Sign in";
      }
    });

    $("nameForm").addEventListener("submit", async event => {
      event.preventDefault();

      const name = $("chatNameInput").value.trim();

      if (name.length < 2 || name.length > 30) {
        $("nameError").textContent =
          "Name must contain 2 to 30 characters.";
        return;
      }

      $("saveNameButton").disabled = true;
      $("nameError").textContent = "";

      try {
        await set(
          ref(db, `${BASE}/users/${currentUser.uid}/chatName`),
          name
        );

        chatName = name;
        $("nameModal").hidden = true;

        if (presenceTabRef) {
          await update(presenceTabRef, {
            chatName,
            online: true,
            lastActive: serverTimestamp()
          });
        }

        if ($("chatScreen").hidden) {
          startChat();
        }
      } catch (error) {
        console.error(error);
        $("nameError").textContent =
          "Could not save your name.";
      } finally {
        $("saveNameButton").disabled = false;
      }
    });

    $("cancelNameButton").onclick = () => {
      $("nameModal").hidden = true;
    };

    $("editNameButton").onclick = () => {
      $("nameTitle").textContent = "Edit your chatting name";
      $("chatNameInput").value = chatName;
      $("cancelNameButton").hidden = false;
      $("nameError").textContent = "";
      $("nameModal").hidden = false;
    };

    $("usersButton").onclick = () => {
      renderUsers();
      $("usersModal").hidden = false;
    };

    $("closeUsersButton").onclick = () => {
      $("usersModal").hidden = true;
    };

    $("closeInfoButton").onclick = () => {
      $("infoModal").hidden = true;
    };

    $("acceptCallButton").onclick = acceptIncomingCall;
    $("rejectCallButton").onclick = rejectIncomingCall;
    $("muteButton").onclick = toggleMute;
    $("cameraButton").onclick = toggleCamera;
    $("speakerButton").onclick = toggleSpeaker;

    $("endCallButton").onclick = async () => {
      await cleanupCall(true);
    };

    $("logoutButton").onclick = async () => {
      await signOut(auth);
    };

    $("messageInput").addEventListener("input", () => {
      const input = $("messageInput");
      input.style.height = "52px";
      input.style.height =
        Math.min(input.scrollHeight, 140) + "px";
      updateSendButton();
    });

    $("composer").addEventListener("submit", async event => {
      event.preventDefault();

      const text = $("messageInput").value.trim();

      if (
        !currentUser ||
        !chatName ||
        !connected ||
        !messagesLoaded ||
        !text
      ) {
        return;
      }

      $("sendButton").disabled = true;

      try {
        await set(push(ref(db, `${BASE}/messages`)), {
          uid: currentUser.uid,
          senderName: chatName,
          text,
          createdAt: serverTimestamp()
        });

        $("messageInput").value = "";
        $("messageInput").style.height = "52px";
      } catch (error) {
        console.error(error);
        $("chatError").textContent =
          "Message could not be sent.";
      }

      updateSendButton();
    });

    document.querySelectorAll(".modal").forEach(modal => {
      modal.addEventListener("click", event => {
        if (event.target === modal) {
          modal.hidden = true;
        }
      });
    });

    document.addEventListener("pointerdown", event => {
      const overlay = document.querySelector(".unsend-overlay");

      if (
        overlay &&
        !event.target.closest(".unsend-overlay") &&
        !event.target.closest(".message")
      ) {
        closeUnsendOverlay();
      }
    });

    window.addEventListener("pagehide", () => {
      if (presenceTabRef && currentUser) {
        remove(presenceTabRef).catch(() => {});
      }
    });

    onAuthStateChanged(auth, async user => {
      cleanup();
      currentUser = user;

      if (!user) {
        applyTipsCamouflage();
        return;
      }

      $("password").value = "";

      try {
        await loadChatName();
      } catch (error) {
        console.error(error);
        $("nameError").textContent =
          "Could not load your name.";
        $("cancelNameButton").hidden = true;
        $("nameModal").hidden = false;
      }
    });

    setPersistence(auth, browserSessionPersistence)
      .then(() => {
        $("loginButton").disabled = false;
        $("loginButton").textContent = "Sign in";
      })
      .catch(error => {
        console.error(error);
        $("loginButton").textContent =
          "Service unavailable";
        $("loginError").textContent =
          "Could not initialize service.";
      });
  </script>
</body>
</html>
